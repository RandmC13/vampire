#------------------------------------------------------------------------------
# HAMR chain (200 x 60 x 20 nm granular FePt film with sensor layer), stage "relax":
# Monte Carlo relaxation at 300 K, saves a checkpoint.
# Grain rounding (create:voronoi-elliptical-rounding) set to 0.5.
#------------------------------------------------------------------------------

#------------------------------------------------------------------------------
# Creation attributes
#------------------------------------------------------------------------------
create:crystal-structure = rocksalt-supercell

create:granular-film
create:grain-tessellation = voronoi
create:grain-periodic-boundaries
create:grain-shape-output
create:grain-statistics-output
create:grain-size = 6.0 !nm
create:grain-size-distribution = normal
create:grain-spacing = 1.0 !nm
create:grain-structure-random-seed = 243831
# fill atoms independent of the number of processes, so that each stage can load the
# checkpoint of the previous one on any number of CPUs or GPUs
create:decomposition-independent-random
create:grain-size-sd = 0.15

# lambda=0.0 - flat column, vertical/"shear" sides, no rounded cap (one
# sweep endpoint). Cap-start height kept at 0.6 for consistency with the
# Phase 2 template even though it has no visible effect at lambda=0.
create:grain-height = 10 !nm
create:voronoi-elliptical-rounding = 0.5
create:voronoi-elliptical-rounding-height = 0.6

create:periodic-boundaries=xy

exchange:interaction-range = 1.0
exchange:function = shell

#------------------------------------------------------------------------------
# System dimensions - x = down-track (long, single track), y = cross-track
# (single track width), z = 10nm magnetic film + 10nm sensor layer
#------------------------------------------------------------------------------
dimensions:unit-cell-size = 10.0 !A
dimensions:system-size-x = 200 !nm
dimensions:system-size-y = 60 !nm
dimensions:system-size-z = 20 !nm

#------------------------------------------------------------------------------
# Material file
#------------------------------------------------------------------------------
material:file = FePt_sensor.mat

#------------------------------------------------------------------------------
# Simulation attributes
#------------------------------------------------------------------------------
sim:equilibration-temperature = 301.0 #XT
sim:temperature = 300.0
sim:time-step = 1.0 !fs
sim:applied-field-strength = 0.0
sim:applied-field-unit-vector = 0,0,-1
sim:time-steps-increment = 1
sim:total-time-steps = 200000
sim:equilibration-time-steps = 10000

sim:save-checkpoint = end
#sim:preconditioning-steps = 10000

#------------------------------------------------------------------------------
# Program and integrator
#------------------------------------------------------------------------------
sim:program = time-series
sim:integrator = monte-carlo

# HAMR parameters - realistic head-speed (unlike simulations/base/dev/, which
# used an unphysically fast head-speed purely for a quick code-correctness
# check). x is down-track (continuous sweep), y is cross-track (discrete
# track stepping): track-size/track-padding chosen so the derived number of
# tracks resolves to exactly 1 (floor((30-1-0)/28) = 1).
#hamr:laser-FWHM-x = 20 !nm
#hamr:laser-FWHM-y = 20 !nm
#hamr:head-speed = 50 !m/s
#hamr:head-field-x = 14 !nm
#hamr:head-field-y = 12 !nm
#hamr:NPS = 5 !nm
#hamr:bit-size = 6 !nm
#hamr:track-size = 28 !nm
#hamr:track-padding = 0 !nm
#hamr:number-of-bits = 33
#hamr:bit-sequence-type = single-tone-predefined

#------------------------------------------------------------------------------
# Dipole read-back field: dense sensor layer sampled via the hierarchical
# solver, ~1nm macrocell resolution.
#------------------------------------------------------------------------------
cells:macro-cell-size = 1.0 !nm
cells:probe-non-magnetic-cells
#dipole:solver = hierarchical
#dipole:output-dipole-field
#dipole:output-atomistic-dipole-field

#------------------------------------------------------------------------------
# Data output
#------------------------------------------------------------------------------
output:output-rate = 100
output:column-headers
output:real-time
output:temperature
output:magnetisation

grain:real-time
grain:temperature
grain:magnetisation
grain:material-magnetisation
grain:output-rate = 1000

config:atoms
config:output-format = binary
config:output-mode = file-per-node
config:output-nodes = 20
config:atoms-output-rate = 100000
