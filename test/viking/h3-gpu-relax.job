#!/usr/bin/env bash
#SBATCH --job-name=vampire-h3-gpu-relax
#SBATCH --account=VIKING_ACCOUNT
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=96G
#SBATCH --time=04:00:00
#------------------------------------------------------------------------------
#
#   This file is part of the VAMPIRE open source package under the
#   Free BSD licence (see licence file for details).
#
#------------------------------------------------------------------------------
# The relaxation of the HAMR chain (the same input as h3-relax.job) with the
# GPU Monte Carlo integrator on one GPU of the partition it is submitted to
# (--partition=gpuplus or gpu), in single precision, followed by a 5 minute
# write on the same GPU restarted from its checkpoint (multi-GPU version on one
# rank, as in h3-bench-gpu.job), which checks that the GPU relaxation can start
# the rest of the chain. The relaxation by the CPU version is in $WORK/h3/relax
# for comparison.
#
# Built from commit COMMIT (default: HEAD of the checkout it is submitted from),
# not from the commit of the chain. Results in $WORK/h3/gpu-relax/<partition>:
# relax/ (output, grain files, time.txt, memory per rank) and write/ (bench.csv
# row in ../bench.csv).
#
# Submit from test/viking (after replacing VIKING_ACCOUNT; WORK must be set, or the log
# file cannot be created and the job fails at once):
#    export WORK=${WORK:-$HOME/scratch/vampire-benchmarks}
#    sbatch --partition=gpuplus --export=ALL,REPO=$(git rev-parse --show-toplevel),WORK=$WORK \
#           --output=$WORK/h3/logs/%x-%j.log h3-gpu-relax.job
#------------------------------------------------------------------------------
source $REPO/test/viking/h3-common.sh
export MPIRUN=$REPO/test/viking/mgpu-launch.sh
partition=$SLURM_JOB_PARTITION
G=$H3/gpu-relax
mkdir -p $G/$partition
commit=$(git -C $REPO rev-parse ${COMMIT:-HEAD})
echo "$commit" > $G/$partition/commit.txt
src=$G/src-$SLURM_JOB_ID
rm -rf $src; mkdir -p $src
git -C $REPO archive $commit | tar -x -C $src

BUILD_SRC=$src build cuda vampire-cuda $H3/bin/vampire-cuda-sp-relax-$partition CUDA_ARCH=-arch=native CUDA_PR=-DCUDA_SP
BUILD_SRC=$src build cuda-multigpu vampire-cuda-multigpu $H3/bin/vampire-mgpu-sp-relax-$partition CUDA_ARCH=-arch=native CUDA_PR=-DCUDA_SP
rm -rf $src
gpu=$(nvidia-smi --query-gpu=name --format=csv,noheader | head -n 1)

# relaxation
dir=$G/$partition/relax
stage_dir relax $dir
echo 1 > $dir/ranks.txt
cd $dir
start=$(date +%s)
$MPIRUN -np 1 $SAMPLE $H3/bin/vampire-cuda-sp-relax-$partition > stdout 2>&1 || { tail -n 30 stdout; exit 1; }
echo "gpu relax: $(( $(date +%s) - start )) s on 1 GPU ($gpu), commit $commit" | tee time.txt
rm -f *.data *.meta   # spin snapshots of the relaxation are not needed
cd - > /dev/null

# write restarted from the GPU relaxation
csv=$G/bench.csv
[ -f $csv ] || echo "partition,device,nodes,ranks,ranks_per_node,precision,skip,atoms,setup_s,steps,window_s,steps_per_s,full_write_h,peak_rss_max_mib,peak_rss_sum_mib,peak_gpu_max_mib,exit" > $csv
dir=$G/$partition/write
stage_dir write $dir
echo "gpu:skip-non-magnetic-atoms" >> $dir/input
result=$(RELAX_DIR=$G/$partition/relax bench_run $dir $MPIRUN -np 1 $SAMPLE $H3/bin/vampire-mgpu-sp-relax-$partition)
atoms=$(awk -F': ' '/Total number of atoms/ { print $2 }' $dir/stdout | head -n 1)
rate=$(echo $result | cut -d, -f4)
echo "$result" | awk -F, -v pre="$partition,$gpu,1,1,1,sp,1,${atoms:-0}" -v h=$(full_write_h $rate) \
   '{ print pre "," $1 "," $2 "," $3 "," $4 "," h "," $5 "," $6 "," $7 "," $8 }' | tee -a $csv
