#------------------------------------------
# laser-pulse program (square profile),
# 3375-atom sc Co, 300 K with a 3 ps pulse
# to 1000 K in 0.5 T
# (a program whose statistics can be
# calculated on the GPU)
#------------------------------------------
create:crystal-structure=sc
dimensions:unit-cell-size = 3.54 !A
dimensions:system-size-x = 5.31 !nm
dimensions:system-size-y = 5.31 !nm
dimensions:system-size-z = 5.31 !nm
material:file=Co.mat
sim:time-step=1.0E-15
sim:program=laser-pulse
sim:integrator=llg-heun
sim:equilibration-temperature=300.0
sim:maximum-temperature=1000.0
sim:laser-pulse-temporal-profile=square
sim:laser-pulse-time=3.0E-12 !s
sim:applied-field-strength=0.5 !T
sim:applied-field-unit-vector=0,0,1
sim:equilibration-time-steps=1000
sim:total-time-steps=8000
sim:time-steps-increment=500
output:temperature
output:magnetisation
output:precision=16
output:column-headers
