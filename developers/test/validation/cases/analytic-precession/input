#------------------------------------------
# Single spin damped precession in an applied
# field, compared with the analytic solution
#------------------------------------------
create:single-spin
material:file=spin.mat
sim:temperature=0.0
sim:time-steps-increment=100
sim:total-time-steps=10000
sim:time-step=1.0E-16
sim:applied-field-strength=10.0 !T
sim:applied-field-unit-vector=0,0,1
sim:program=time-series
sim:integrator=llg-heun
output:real-time
output:magnetisation
output:precision=16
output:column-headers
