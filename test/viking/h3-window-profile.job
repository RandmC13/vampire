#!/usr/bin/env bash
#SBATCH --job-name=vampire-h3-window-profile
#SBATCH --account=VIKING_ACCOUNT
#SBATCH --partition=gpuplus
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=96G
#SBATCH --time=01:00:00
#------------------------------------------------------------------------------
#
#   This file is part of the VAMPIRE open source package under the
#   Free BSD licence (see licence file for details).
#
#------------------------------------------------------------------------------
# Nsight Systems profiles of the HAMR chain write on one GPU (multi-GPU version
# on one rank, single precision, gpu:skip-non-magnetic-atoms), restarted from
# the relaxed state in $WORK/h3/relax, with and without hamr:active-window:
#
#   nowindow  capture of PROFILE_DURATION seconds starting NOWINDOW_DELAY
#             seconds after launch (the cost of a step does not depend on the
#             head position without the window)
#   window    capture of PROFILE_DURATION seconds starting WINDOW_DELAY seconds
#             after launch, when the head is in the middle of the track and the
#             window has its largest size
#
# Each run is stopped when its capture ends; no spin snapshots or checkpoints
# are written. Built from commit COMMIT (default: HEAD of the checkout it is
# submitted from). Results in $WORK/h3/window-profile/<run>: report.sqlite and
# summary tables of the capture, log, output, time.txt.
#
# Submit from test/viking (after replacing VIKING_ACCOUNT; WORK must be set, or the log
# file cannot be created and the job fails at once):
#    export WORK=${WORK:-$HOME/scratch/vampire-benchmarks}
#    sbatch --export=ALL,REPO=$(git rev-parse --show-toplevel),WORK=$WORK \
#           --output=$WORK/h3/logs/%x-%j.log h3-window-profile.job
#------------------------------------------------------------------------------
source $REPO/test/viking/h3-common.sh
export MPIRUN=$REPO/test/viking/mgpu-launch.sh
command -v nsys > /dev/null || PATH=$(ls -d ${EBROOTCUDA:-}/nsight-systems*/bin 2> /dev/null | tail -n 1):$PATH
command -v nsys > /dev/null || { echo "nsys not found"; exit 1; }
nsys --version
[ -f $H3/relax/ranks.txt ] || { echo "Error: no relaxed state in $H3/relax"; exit 1; }
P=$H3/window-profile
mkdir -p $P
commit=$(git -C $REPO rev-parse ${COMMIT:-HEAD})
echo "$commit" > $P/commit.txt
src=$P/src-$SLURM_JOB_ID
rm -rf $src; mkdir -p $src
git -C $REPO archive $commit | tar -x -C $src
bin=$H3/bin/vampire-mgpu-sp-window-profile
BUILD_SRC=$src build cuda-multigpu vampire-cuda-multigpu $bin CUDA_ARCH=-arch=native CUDA_PR=-DCUDA_SP
rm -rf $src

# profile <run> <delay> [input lines]: one write under Nsight Systems, stopped when the capture ends
profile(){
   local name=$1 dir=$P/$1 delay=$2
   shift 2
   stage_dir write $dir
   sed -i -e '/^sim:save-checkpoint/d' -e '/^config:/d' $dir/input
   printf '%s\n' "gpu:skip-non-magnetic-atoms" "$@" >> $dir/input
   link_checkpoint $H3/relax $dir
   local start=$(date +%s)
   ( cd $dir && $MPIRUN -np 1 nsys profile --trace=cuda,osrt --sample=process-tree --delay=$delay \
        --duration=${PROFILE_DURATION:-20} --kill=sigterm --force-overwrite=true --output=$dir/report $bin > stdout 2>&1 )
   echo "$name: exit $?, $(( $(date +%s) - start )) s, $(grep -vc '^#' $dir/output) output rows" | tee $dir/time.txt
   nsys stats --report cuda_gpu_kern_sum,cuda_gpu_mem_time_sum,cuda_api_sum,osrt_sum --format csv \
      --output $dir/report $dir/report.nsys-rep > $dir/report-stats.log 2>&1
   rm -f $dir/*.chk
}
profile nowindow ${NOWINDOW_DELAY:-300}
profile window ${WINDOW_DELAY:-1000} "hamr:active-window"
grep -h 'HAMR active window:' $P/window/log | tail -n 1
ls -l $P/*
