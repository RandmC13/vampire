{
   "description": "hysteresis-loop program, 3375-atom sc Co, T=0, +/-2 T in 0.5 T steps of 1 ps (too short to switch): magnetisation and mean magnetisation at each field",
   "kind": "deterministic",
   "quantities": {
      "B": "B_applied",
      "mx": "s0M_norm_x*s0M_norm_l",
      "my": "s0M_norm_y*s0M_norm_l",
      "mz": "s0M_norm_z*s0M_norm_l",
      "mean_mx": "s0M_norm_mean_x*s0M_norm_mean_l",
      "mean_my": "s0M_norm_mean_y*s0M_norm_mean_l",
      "mean_mz": "s0M_norm_mean_z*s0M_norm_mean_l"
   },
   "tolerance": {
      "dp": {
         "rtol": 1e-08,
         "atol": 1e-08
      },
      "sp": {
         "rtol": 0.0001,
         "atol": 0.0001,
         "rows": 10
      }
   }
}
