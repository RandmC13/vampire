#!/usr/bin/env bash
#SBATCH --job-name=vampire-recon
#SBATCH --account=VIKING_ACCOUNT
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=8G
#SBATCH --gres=gpu:1
#SBATCH --time=0-00:15:00
#------------------------------------------------------------------------------
#
#   This file is part of the VAMPIRE open source package under the
#   Free BSD licence (see licence file for details).
#
#------------------------------------------------------------------------------
# Records the software and hardware available on a GPU node (submit with
# --partition=gpu_short or gpuplus): CUDA/MPI/NCCL modules, GPU topology,
# interconnect and profiler counter access. Writes $WORK/recon/<partition>.txt.
#------------------------------------------------------------------------------
source $REPO/test/viking/common.sh
set +u
mkdir -p $WORK/recon
exec > $WORK/recon/$SLURM_JOB_PARTITION.txt 2>&1

section(){ echo; echo "=== $* ==="; }
section host;          hostname; cat /etc/os-release; lscpu | head -n 20; free -g
section gpus;          nvidia-smi; nvidia-smi topo -m; nvidia-smi nvlink --status
section counters;      grep -i profiling /proc/driver/nvidia/params
section cuda;          module list; nvcc --version; which nsys ncu; g++ --version
for m in CUDA GCC foss OpenMPI UCX UCX-CUDA NCCL NVHPC Nsight; do
   section "module spider $m"; module -t spider $m
done
section interconnect;  ls /sys/class/infiniband; ibstat 2> /dev/null | head -n 30
section openmpi;       module load OpenMPI && { ompi_info | grep -i -E 'version|cuda|ucx' | head -n 20; ucx_info -v; }
