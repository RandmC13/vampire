#!/usr/bin/env bash
#SBATCH --job-name=vampire-scale-relax
#SBATCH --account=VIKING_ACCOUNT
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=96G
#------------------------------------------------------------------------------
#
#   This file is part of the VAMPIRE open source package under the
#   Free BSD licence (see licence file for details).
#
#------------------------------------------------------------------------------
# Check of hamrvis at scale, stage 1: the Monte Carlo relaxation of the HAMR
# chain (input test/viking/h3/relax) with the CUDA version on one GPU, single
# precision. Its spin snapshots are kept: hamrvis reduces and checks them.
# Submitted by scale-submit.sh. Results in $WORK/h3/scale/relax.
#------------------------------------------------------------------------------
source $REPO/test/viking/h3-common.sh
S=$H3/scale
dir=$S/relax
stage_dir relax $dir
echo 1 > $dir/ranks.txt
cd $dir
start=$(date +%s)
$REPO/test/viking/mgpu-launch.sh -np 1 $SAMPLE $S/bin/vampire-cuda-sp > stdout 2>&1 || { tail -n 30 stdout; exit 1; }
echo "relax: $(( $(date +%s) - start )) s on 1 GPU ($(nvidia-smi --query-gpu=name --format=csv,noheader | head -n 1))" | tee time.txt
chmod a-w vampire*.chk   # the writes copy them
